# Fill exactly one model profile. Never commit real credentials.

# Required by the default AMiner discovery provider, public backward-reference
# lookup, title-to-pub_id resolution, and --pub-id acquisition.
AMINER_API_KEY=
# Optional runtime override for AMiner usage statistics; otherwise auto-detected.
# Values: claude-code|cursor|codex|openclaw|unknown.
AMINER_SKILL_RUNTIME=

# Optional provider controls. Defaults shown here never silently use an
# external fallback. Values: aminer|openalex|arxiv; none|openalex|arxiv;
# auto|free|search-pro|qa-pro.
BASELINE_RETRIEVAL_PROVIDER=aminer
BASELINE_EXTERNAL_FALLBACK_PROVIDER=none
BASELINE_AMINER_SEARCH_TIER=auto
BASELINE_AMINER_DETAIL_LIMIT=3

# Optional network proxy used by selected network providers.
HTTPS_PROXY=
HTTP_PROXY=

# DeepSeek (base URL is optional and defaults to the official endpoint).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GLM, GLM 5.3, and GLM 5.3 Flash.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2
GLM53_MODEL=glm-5.3
GLM53_FLASH_MODEL=glm-5.3-flash
GLM53_THINKING_EFFORT=low

# Cross-process GLM request gate. All workers that share one gate directory
# must use the same capacity. Set capacity to 0 to disable the gate. When
# workers run in separate containers or hosts, point the directory at one
# shared filesystem location.
BASELINE_GLM_GLOBAL_CONCURRENCY=6
# BASELINE_GLM_GATE_DIR=/absolute/shared/path/baseline-finder-glm-gate
BASELINE_GLM_GATE_TIMEOUT_SECONDS=600
BASELINE_GLM_GATE_POLL_SECONDS=0.05

# Candidate-selector batch workers per paper. Default 3; accepted range 1..3.
BASELINE_SELECTOR_MAX_WORKERS=3
# balanced divides the shortlist into the minimum number of near-equal,
# contiguous batches of at most 20; fixed uses legacy consecutive 20-item chunks.
BASELINE_SELECTOR_BATCH_STRATEGY=balanced

# GPT requires an explicitly trusted OpenAI-compatible endpoint.
GPT_API_KEY=
GPT_BASE_URL=
GPT_MODEL=gpt-5.6-sol

# Optional local service and runtime settings.
GROBID_URL=http://127.0.0.1:8070
# BASELINE_AUDIT_WORK_DIR=/absolute/private/path
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_RETRIES=0
