{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aminer-open-skill:sota-finder:evidence:v1",
  "title": "SOTA Finder Evidence v1",
  "type": "object",
  "required": [
    "schema_version",
    "research_run",
    "coverage",
    "scopes",
    "claims",
    "sources",
    "conflicts"
  ],
  "properties": {
    "schema_version": {
      "const": "sota-finder.evidence.v1"
    },
    "research_run": {
      "type": "object",
      "required": [
        "run_id",
        "topic",
        "topic_slug",
        "query",
        "evidence_checked_through",
        "generated_at",
        "language",
        "aminer"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^run-"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "topic_slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "evidence_checked_through": {
          "type": "string",
          "format": "date"
        },
        "generated_at": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "aminer": {
          "type": "object",
          "required": [
            "used"
          ],
          "properties": {
            "used": {
              "type": "boolean"
            },
            "purpose": {
              "type": [
                "string",
                "null"
              ]
            },
            "estimated_cost_cny": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "actual_cost_cny": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "skipped_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": [
        "searched_source_types",
        "stop_reason",
        "gaps"
      ],
      "properties": {
        "searched_source_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_reason": {
          "type": "string"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matrix": {
          "type": "object",
          "required": [
            "title",
            "columns",
            "rows",
            "notes"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scope_id",
          "name",
          "task",
          "metric",
          "main_claim_ids",
          "reference_claim_ids",
          "unavailable_claim_ids",
          "conflict_ids"
        ],
        "properties": {
          "scope_id": {
            "type": "string",
            "pattern": "^scope-"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "benchmark": {
            "type": [
              "string",
              "null"
            ]
          },
          "benchmark_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "dataset_or_subtask": {
            "type": [
              "string",
              "null"
            ]
          },
          "split": {
            "type": [
              "string",
              "null"
            ]
          },
          "metric": {
            "type": "object",
            "required": [
              "name",
              "direction"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "variant": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "direction": {
                "enum": [
                  "higher",
                  "lower"
                ]
              }
            },
            "additionalProperties": true
          },
          "evaluation_protocol": {
            "type": [
              "string",
              "null"
            ]
          },
          "material_axes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "main_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unavailable_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflict_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "scope_id",
          "section",
          "method",
          "score_display",
          "evidence_source_ids",
          "comparability_complete",
          "rank",
          "sota"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^clm-"
          },
          "scope_id": {
            "type": "string",
            "pattern": "^scope-"
          },
          "section": {
            "enum": [
              "main",
              "reference",
              "unavailable"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": [
              "string",
              "null"
            ]
          },
          "score_numeric": {
            "type": [
              "number",
              "null"
            ]
          },
          "score_display": {
            "type": "string"
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "sota": {
            "type": "boolean"
          },
          "comparability_complete": {
            "type": "boolean"
          },
          "evidence_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_locators": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "setting": {
            "type": "object"
          },
          "method_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "type",
          "title",
          "authority",
          "accessed_date",
          "available"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src-"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "authority": {
            "enum": [
              "official",
              "primary",
              "author",
              "secondary",
              "aggregator"
            ]
          },
          "accessed_date": {
            "type": "string",
            "format": "date"
          },
          "available": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "conflict_id",
          "scope_id",
          "summary",
          "status",
          "claim_ids",
          "source_ids"
        ],
        "properties": {
          "conflict_id": {
            "type": "string",
            "pattern": "^conflict-"
          },
          "scope_id": {
            "type": "string",
            "pattern": "^scope-"
          },
          "summary": {
            "type": "string"
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved",
              "unavailable"
            ]
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "validation_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
